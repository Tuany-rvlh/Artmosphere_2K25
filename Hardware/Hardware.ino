void setup() {
  Serial.begin(9600);      //permite a comunicação com o monitor
  Serial3.begin(9600);    // inicia a comunicação com a porta serial do arduino 
  Serial3.println("Leitor RFID RDM6300 iniciado");   //avisa qye já pode ler as tags

  pinMode(led, OUTPUT);     //identifica qais componentes são entrada e quais são saídas
  pinMode(botao, INPUT);
  
  pinMode(botao1, INPUT);
  pinMode(botao2, INPUT);
  pinMode(botao3, INPUT);
  pinMode(botao4, INPUT);
  
  pinMode(ledBranco, OUTPUT);  
  pinMode(ledVerde, OUTPUT);  
  pinMode(ledAmarelo, OUTPUT);  
  pinMode(ledVermelho, OUTPUT);  

  disp_graph_init();
  inicio();

  // pinos dos displays
  for (int i = 0; i < 4; i++) {
    pinMode(pinosBCD1[i], OUTPUT);
    pinMode(pinosBCD2[i], OUTPUT);

  }

  // LED fim
  pinMode(ledFim, OUTPUT);
  digitalWrite(ledFim, LOW);

  // botões
  pinMode(botaoGanhador, INPUT); // idem

  atualizarDisplay(tempo); // mostra 90 no início

  //dfplayer 

  mySerial.begin(9600);
  if (!myMP3.begin(mySerial)) {
  Serial.println("Erro: DFPlayer Mini não inicializou.");
  while(true); // para aqui se não inicializar
  }
  myMP3.volume(30); // Ajuste do volume (0-30)
  myMP3.stop();


}

