      u8g.drawXBMP( 0, 0, 128, 64, capa); // Chamando a página com a exibição do bitmap 1
      } while( u8g.nextPage() ); // chamando uma nova página após o tempo definido no delay.
}

// Atualiza os dois displays (unidade e dezena)
void atualizarDisplay(int valor) {
  int unidade = valor % 10;
  int dezena = (valor / 10)  ;
 
  enviarBCD(pinosBCD1, dezena);
  enviarBCD(pinosBCD2, unidade);
}

// Converte número (0–9) para BCD e manda para os pinos do CI
void enviarBCD(const int pinos[4], int numero) {
  for (int i = 0; i < 4; i++) {
    int bitVal = (numero >> i) & 0x01;
    digitalWrite(pinos[i], bitVal);
  }
}
